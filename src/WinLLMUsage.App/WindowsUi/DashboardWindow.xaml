<Window x:Class="WinLLMUsage.App.WindowsUi.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinLLMUsage"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#1E1E1E"
        Foreground="#F5F5F5">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="12" Background="#252525">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="10,4"/>
        <Button Content="Settings" Click="Settings_Click" Margin="0,0,8,0" Padding="10,4"/>
        <Button Content="Exit" Click="Exit_Click" Padding="10,4"/>
      </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
      <ItemsControl ItemsSource="{Binding Cards}" Margin="12">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,12" Padding="12" Background="#2A2A2A" CornerRadius="8">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/>
                <ItemsControl ItemsSource="{Binding Descriptors}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,2">
                        <TextBlock Text="{Binding Title}" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding MetricLabel}" HorizontalAlignment="Right" Opacity="0.7"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>

<Window x:Class="WinLLMUsage.App.WindowsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420"
        Height="420"
        Background="#1E1E1E"
        Foreground="#F5F5F5"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16">
    <CheckBox x:Name="Privacy" Content="Privacy Mode" Margin="0,8"/>
    <CheckBox x:Name="Api" Content="Local HTTP API (127.0.0.1:6736)" Margin="0,8"/>
    <CheckBox x:Name="Startup" Content="Launch at login" Margin="0,8"/>
    <CheckBox x:Name="Pacing" Content="Always show pacing" Margin="0,8"/>
    <TextBlock Text="OpenRouter API key" Margin="0,12,0,4"/>
    <PasswordBox x:Name="OpenRouterKey"/>
    <TextBlock Text="Z.ai API key" Margin="0,12,0,4"/>
    <PasswordBox x:Name="ZaiKey"/>
    <Button Content="Save" Click="Save_Click" Margin="0,20,0,0" Padding="12,6" HorizontalAlignment="Right"/>
  </StackPanel>
</Window>

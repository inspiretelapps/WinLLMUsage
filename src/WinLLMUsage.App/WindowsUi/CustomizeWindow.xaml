<Window x:Class="WinLLMUsage.App.WindowsUi.CustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize"
        Width="420"
        Height="480"
        Background="#1E1E1E"
        Foreground="#F5F5F5"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Text="Providers" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <Button DockPanel.Dock="Bottom" Content="Done" Click="Done_Click" Padding="12,6" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    <ListBox x:Name="Providers"/>
  </DockPanel>
</Window>
